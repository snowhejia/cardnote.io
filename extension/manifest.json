{
  "manifest_version": 3,
  "name": "卡片笔记剪藏",
  "version": "1.0.25",
  "description": "一键把小红书 / B 站内容剪藏到卡片笔记。",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://www.xiaohongshu.com/*",
    "https://*.xiaohongshu.com/*",
    "https://*.xhscdn.com/*",
    "https://www.bilibili.com/*",
    "https://*.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://*.bilivideo.com/*",
    "https://*.bilivideo.cn/*",
    "https://*.szbdyd.com/*",
    "https://*.bytecdntp.com/*",
    "https://*.akamaized.net/*",
    "https://api.bilibili.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "剪藏到卡片笔记",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://*.xiaohongshu.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://*.bilibili.com/video/*"
      ],
      "js": ["content-bilibili.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
